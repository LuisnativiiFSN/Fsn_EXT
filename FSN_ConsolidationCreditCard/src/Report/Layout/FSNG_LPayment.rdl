  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Function NumeroALetras(ByVal number As Decimal) As String
    Dim unidades() As String = {"Cero", "Uno", "Dos", "Tres", "Cuatro", "Cinco", "Seis", "Siete", "Ocho", "Nueve", "Diez", "Once", "Doce", "Trece", "Catorce", "Quince", "Dieciséis", "Diecisiete", "Dieciocho", "Diecinueve"}
    Dim decenas() As String = {"", "", "Veinte", "Treinta", "Cuarenta", "Cincuenta", "Sesenta", "Setenta", "Ochenta", "Noventa"}
    Dim centenas() As String = {"", "Ciento", "Doscientos", "Trescientos", "Cuatrocientos", "Quinientos", "Seiscientos", "Setecientos", "Ochocientos", "Novecientos"}

    ' Separar la parte entera y la parte decimal
    Dim parteEntera As Integer = Math.Floor(number)
    Dim parteDecimal As Integer = Math.Round((number - parteEntera) * 100)

    ' Convertir la parte entera a letras
    Dim letras As String = ""
    If parteEntera = 0 Then
        letras = "Cero"
    ElseIf parteEntera &lt; 20 Then
        letras = unidades(parteEntera)
    ElseIf parteEntera &lt; 100 Then
        letras = decenas(Math.Floor(parteEntera / 10)) &amp; If(parteEntera Mod 10 &gt; 0, " y " &amp; unidades(parteEntera Mod 10), "")
    ElseIf parteEntera &lt; 1000 Then
        letras = centenas(Math.Floor(parteEntera / 100)) &amp; If(parteEntera Mod 100 &gt; 0, " " &amp; NumeroALetras(parteEntera Mod 100), "")
    ElseIf parteEntera &lt; 1000000 Then
        If parteEntera = 1000 Then
            letras = "Mil"
        Else
            letras = NumeroALetras(Math.Floor(parteEntera / 1000)) &amp; " Mil" &amp; If(parteEntera Mod 1000 &gt; 0, " " &amp; NumeroALetras(parteEntera Mod 1000), "")
        End If
    ElseIf parteEntera &lt; 1000000000 Then
        If parteEntera = 1000000 Then
            letras = "Un Millón"
        Else
            letras = NumeroALetras(Math.Floor(parteEntera / 1000000)) &amp; " Millones" &amp; If(parteEntera Mod 1000000 &gt; 0, " " &amp; NumeroALetras(parteEntera Mod 1000000), "")
        End If
    Else
        letras = "Cantidad fuera de rango"
    End If

    ' Convertir los centavos a letras
    Dim centavos As String = ""
    If parteDecimal &gt; 0 Then
        centavos = " con " &amp; If(parteDecimal &lt; 20, unidades(parteDecimal), decenas(Math.Floor(parteDecimal / 10)) &amp; If(parteDecimal Mod 10 &gt; 0, " y " &amp; unidades(parteDecimal Mod 10), "")) &amp; " centavos"
    End If

    Return letras &amp; centavos
End Function

Dim GroupTotal As Decimal

Function SetGroupTotal(ByVal Amount As Decimal)
    GroupTotal += Amount
    Return GroupTotal
End Function

Function ResetGroupTotal()
    GroupTotal = 0
    Return GroupTotal
End Function</Code>
