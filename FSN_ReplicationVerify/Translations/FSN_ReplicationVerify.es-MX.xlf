        <trans-unit id="Codeunit 2839556462 - Method 34862469 - NamedType 1033806989" size-unit="char" translate="yes" xml:space="preserve">
          <source>use master CREATE TABLE #Temp1 (drive varchar(5),[MB] decimal) INSERT INTO #Temp1 EXEC XP_FIXEDDRIVES CREATE TABLE #Temp2 (IP varchar(max)) INSERT INTO #Temp2 EXEC master..xp_cmdshell 'ipconfig' select substring(t2.IP,CHARINDEX(':',t2.IP,1)+2,LEN(t2.IP)-(CHARINDEX(':',t2.IP,1)+1)) as local_net_address,t1.drive,t1.[MB]from  #Temp1 t1 join  #Temp2 t2 on t2.IP like '%IPv4%' and t1.drive='C'</source>
          <target>[NAB: REVIEW]use master CREATE TABLE #Temp1 (drive varchar(5),[MB] decimal) INSERT INTO #Temp1 EXEC XP_FIXEDDRIVES CREATE TABLE #Temp2 (IP varchar(max)) INSERT INTO #Temp2 EXEC master..xp_cmdshell 'ipconfig' select substring(t2.IP,CHARINDEX(':',t2.IP,1)+2,LEN(t2.IP)-(CHARINDEX(':',t2.IP,1)+1)) as local_net_address,t1.drive,t1.[MB]from  #Temp1 t1 join  #Temp2 t2 on t2.IP like '%IPv4%' and t1.drive='C'</target>
