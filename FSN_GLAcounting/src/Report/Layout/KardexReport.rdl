  <Code>Public Dim Qty, QtyM As Decimal
Public Dim OldCost, NewCost As Decimal
Public Dim Salida As Double
Public Dim Entrada As Double
Public Dim NoPrimero as Boolean
Public Dim SaldoInicial as Decimal

Public Function OldCostInit(ByVal Value As Decimal)
   OldCost = Value
   NewCost = Value
   QtyM = value
   SaldoInicial  = 0
   NoPrimero = false
   Return OldCost
End Function

Public Function QtyInit(ByVal Value As Decimal)
    Qty = Value
    Return Qty
End Function

Public Function QtyMInit(ByVal Value As Decimal)
    IF Value = 0 Then QtyM = OldCost Else QtyM = Value
    Return QtyM
End Function

Public Function AddQuantity(ByVal Value As Decimal)
    Qty += Value
    Return Qty
End Function

Public Function AddQuantityM(ByVal Value As Decimal)
   IF Not NoPrimero and SaldoInicial = 0 Then 
      QtyM = 0
      NoPrimero = true
      OldCost = OldCost * Qty
   End If
    QtyM += Value
    Return QtyM
End Function

Public Function SaleCost()
    OldCost=round(QtyM/IIF(Qty=0,1,Qty),2)
    Return OldCost
End Function

Public Function PurCost(ByVal cost As Decimal,ByVal cant As Decimal)
    NewCost=round(cost/IIF(cant=0,1,cant),2)
    Return NewCost
End Function

Public Function SalidaM(ByVal cant As Double)
    Salida=round((OldCost*cant),2)
    Return Salida
End Function

Public Function EntradaM(ByVal cant As Double)
    Entrada=round((NewCost*cant),2)
    Return Entrada
End Function
</Code>
