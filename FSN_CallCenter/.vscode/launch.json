        {
            "name": "Publish: Testing server",
            "type": "al",
            "request": "launch",
            "environmentType": "OnPrem",
            "server": "http://10.0.20.198:8080/BCENTRALDEV",
            "serverInstance": "BCDEV",
            "port": 7089,
            "authentication": "Windows",
            "startupObjectId": 22,
            "breakOnError": "All",
            "breakOnRecordWrite": "None",
            "launchBrowser": true,
            "enableSqlInformationDebugger": true,
            "enableLongRunningSqlStatements": true,
            "longRunningSqlStatementsThreshold": 500,
            "numberOfSqlStatements": 10,
            "tenant": "default",
            "usePublicURLFromServer": false
        },
        {
            "name": "On-Pre attach",
            "request": "attach",
            "type": "al",
            "environmentType": "OnPrem",
            "server": "http://localhost:8080",
            "serverInstance": "BCentral",
            "port": 7049,
            "authentication": "Windows",
            "breakOnError": true,
            "enableSqlInformationDebugger": true,
            "enableLongRunningSqlStatements": true,
            "longRunningSqlStatementsThreshold": 2000,
            "numberOfSqlStatements": 100,
            "breakOnNext": "WebServiceClient",
            "resourceExposurePolicy": {
                "AllowDebugging": true,
                "AllowDownloadingSource": false,
                "IncludeSourceInSymbolFile": false
            },
            "launchBrowser": true,
            "tenant": "default",
            "schemaUpdateMode": "ForceSync"
        }
    ]
}