  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BuiltLine(ByVal txtCliente as String, ByVal txtReceta as String, ByVal txtCodigo as String, ByVal txtDescrip as String, ByVal cant as Integer, ByVal unitario as Decimal, ByVal descuento as Decimal, ByVal total as Decimal, ByVal unitarioIva as Decimal, ByVal totalIva as Decimal) 
   Dim txtLinea as String
   Dim esVivir, esCel, esMediprocesos, esAsesuisa as Boolean
   
   esVivir = (txtCliente = "C000004")
   esCel = (txtCliente = "C000002")
   esMediprocesos = (txtCliente = "C000001")
   esAsesuisa = (txtCliente = "HOC085121")
   
   if not (esVivir or esCel or esMediprocesos or esAsesuisa) then 
      txtLinea = txtLinea + left(trim(txtReceta) + space(10), 10) + space(2)
   end if

   txtLinea = txtLinea + left(trim(txtCodigo) + space(6), 6) + space(2) 

   txtLinea = txtLinea + right(space(3) + trim(str(cant)), 3) + space(2)

   if not (esVivir or esCel or esMediprocesos or esAsesuisa) then 
      txtLinea = txtLinea + left(trim(txtDescrip) + space(20), 30) + space(2)
   else
      txtLinea = txtLinea + left(trim(txtDescrip) + space(32), 42) + space(2)
   end if

   if not esMediprocesos then 
      txtLinea = txtLinea + right(space(10) + formatnumber(unitarioIva, 4), 10) + space(2)
      txtLinea = txtLinea + right(space(5) + formatnumber(descuento, 2), 5) + space(2)
   else
      txtLinea = txtLinea + space(5) + space(2)
      txtLinea = txtLinea + right(space(10) + formatnumber(unitario, 4), 10) + space(2)
   end if
   
   if not esVivir then 
      txtLinea = txtLinea + right(space(9) + formatnumber(total, 2), 9)
   else
      txtLinea = txtLinea + right(space(9) + formatnumber(totalIva, 2), 9)
   end if
   
   return txtLinea
End Function
</Code>
